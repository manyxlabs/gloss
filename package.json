{
  "name": "gloss",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs.mjs && node scripts/copy-ocr.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs.mjs && node scripts/copy-ocr.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "test:e2e": "playwright test",
    "test:sync": "playwright test -c playwright.sync.config.ts",
    "format": "prettier --write .",
    "check": "tsc && tsc -p worker",
    "worker": "npm run build && wrangler dev --port 8787"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "@xyflow/react": "^12.12.0",
    "docx": "^9.14.0",
    "fflate": "^0.8.3",
    "heic-to": "^1.6.6",
    "html-to-image": "1.11.11",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "uqr": "^0.1.3",
    "wasm-feature-detect": "^1.9.0",
    "yjs": "^13.6.33",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@eslint/js": "^10.0.1",
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "linkedom": "^0.18.14",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.152.0"
  }
}
