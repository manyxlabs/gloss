{
  "name": "gloss",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "check": "tsc && tsc -p worker",
    "worker": "npm run build && wrangler dev --port 8787"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
